<?php

declare(strict_types=1);

use CuyZ\Valinor\Mapper\Configurator\ConvertKeysToCamelCase;

/**
 * Default configuration for sirix/mezzio-valinor-request-mapper.
 *
 * Copy this file to config/autoload/mezzio-valinor.global.php and adjust.
 */
return [
    'sirix_mezzio_valinor' => [
        // --- MapperBuilder options ---
        'mapper' => [
            // Configurators: FQCN implementing MapperBuilderConfigurator.
            // Resolved from container if available, otherwise instantiated directly.
            //
            // Built-in configurators from cuyz/valinor:
            //   ConvertKeysToCamelCase  — snake_case / kebab-case → camelCase
            //   ConvertKeysToSnakeCase  — camelCase / kebab-case → snake_case
            //   RestrictKeysToCamelCase — reject keys not in camelCase
            //   RestrictKeysToSnakeCase — reject keys not in snake_case
            //   RestrictKeysToKebabCase — reject keys not in kebab-case
            //   RestrictKeysToPascalCase — reject keys not in PascalCase
            //
            // You can also register custom configurators implementing:
            //   CuyZ\Valinor\Mapper\Configurator\MapperBuilderConfigurator
            'configurators'              => [
                ConvertKeysToCamelCase::class,
            ],

            // Allow extra keys in input that are not mapped. For HTTP request
            // mapping, extra top-level keys in body/query/route are still
            // ignored; this flag primarily affects direct array mapping.
            'allow_superfluous_keys'     => true,

            // Allow automatic scalar type casting (e.g. int → string). For HTTP
            // mapping, strings from query/route parameters are always cast to
            // target scalar types; this flag mainly controls body/array mapping.
            'allow_scalar_value_casting' => true,

            // Allow mixed/object types in DTO (disabled by valinor strict mode)
            'allow_permissive_types'     => false,

            // Treat missing keys as null instead of raising an error
            'allow_undefined_values'     => false,

            // Additional date formats appended to those already supported by the
            // configured builder. This includes formats set by configurators; if no
            // configurator replaces them, Valinor's default RFC 3339 / timestamp
            // formats are preserved as well. Use an empty list to keep the builder's
            // current formats unchanged.
            // Example: ['Y-m-d', 'd/m/Y H:i:s']
            'support_date_formats'       => [],

            // Path to the Valinor cache directory. Must be outside the public
            // web root. When null, no file-system cache is used.
            'cache_dir'                  => null,

            // Watch PHP files for changes and invalidate the cache automatically.
            // Enable in development; disable in production.
            'cache_watch'                => false,
        ],

        // --- Default mapping error response limits ---
        // Applied only to the built-in DefaultMappingErrorResponder. Custom
        // responders keep their own contract and are not bounded by these.
        'error_response' => [
            // Maximum number of mapping messages retained in the response.
            // null keeps every message. When the limit is reached, one extra
            // message is appended to the root path to signal truncation.
            //
            // This does not stop Valinor from building the full error tree; it
            // only bounds what is retained and serialized.
            'max_messages'       => null,

            // Maximum size, in bytes, of the serialized JSON body (no headers,
            // no compression). null disables the limit. Minimum accepted value
            // is 256. Oversized bodies are replaced with a fixed envelope.
            'max_response_bytes' => null,
        ],
    ],
];
